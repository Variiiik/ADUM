# ── Rakendus ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# HTTPS=true seab küpsises Secure lipu — lülita sisse kui Nginx teeb SSL-i
HTTPS=true
# TRUST_PROXY=true — vajalik kui rakendus töötab Nginx/pöördpuhverserveri taga
# (production režiimis lubatakse automaatselt)
TRUST_PROXY=true

# ── Sessiooni salajane võti (minimaalselt 64 märki) ────────────────────────────
# Genereeri: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=muuda-siia-pikk-juhuslik-string-minimaalselt-64-marg

# ── MySQL / MariaDB ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=adum
DB_PASS=muuda-siia-tugev-parool
DB_NAME=adum

# ── LDAP / Active Directory ────────────────────────────────────────────────────
# LDAPS (port 636) on soovitatav tootmiskeskkonnas
LDAP_URL=ldaps://dc01.haigla.vmh.ee:636
LDAP_BASE_DN=DC=haigla,DC=vmh,DC=ee
LDAP_BIND_DN=CN=svc-admanager,OU=Service Accounts,DC=haigla,DC=vmh,DC=ee
LDAP_BIND_PASS=teenusekonto-parool
LDAP_USERS_OU=OU=Kasutajad,DC=haigla,DC=vmh,DC=ee
LDAP_GROUPS_OU=OU=Grupid,DC=haigla,DC=vmh,DC=ee
# AD grupp, mille liikmed saavad administraatori õigused ADUM-is
LDAP_ADMIN_GROUP=ADUM-Admins
# AD grupp HR kasutajatele (valikuline)
LDAP_HR_GROUP=ADUM-HR
# UPN sufiks kui erineb BASE_DN-st (nt varik.local vs varik.ee)
# LDAP_UPN_SUFFIX=haigla.vmh.ee
# Lisadomeenid e-posti aadressidele, komaga eraldatud
# LDAP_EXTRA_DOMAINS=haigla.ee,vmh.ee
# TLS sertifikaadi kontroll — sea true kui AD sertifikaat on usaldusväärne
LDAP_TLS_VERIFY=false
LDAP_DEBUG=false

# ── Kohalik administraator (varusisselogimine ilma AD-ta) ─────────────────────
LOCAL_ADMIN_USER=localadmin
LOCAL_ADMIN_PASS=muuda-siia-tugev-parool

# ── AD teenuse atribuut ────────────────────────────────────────────────────────
# LDAP atribuut kuhu teenuste rollid salvestatakse (vaikimisi extensionAttribute1)
# AD_SERVICE_ATTRIBUTE=extensionAttribute1

# ── Mock režiim (ainult arenduseks) ───────────────────────────────────────────
MOCK_AD=false
# MOCK_ADMIN_USER=admin
# MOCK_ADMIN_PASS=admin123
